{
  "name": "courseflix",
  "version": "1.0.0",
  "description": "CourseFlix is an Arabic-first, RTL learning platform for teachers and students. The graduation-project MVP combines course delivery, progress tracking, objective quizzes, PDF-grounded AI assistance, deterministic learning interventions, test commerce, teacher sales analytics, and privacy-safe product analytics.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/worker"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run start:dev -w apps/worker",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:worker": "npm run build -w apps/worker",
    "lint:api": "npm run lint -w apps/api",
    "lint:web": "npm run lint -w apps/web",
    "test:api": "npm run test -w apps/api",
    "test:web": "npm run test -w apps/web",
    "test:worker": "npm run test -w apps/worker",
    "migration:run": "npm run migration:run -w apps/api",
    "seed": "npm run seed -w apps/api",
    "test": "npm run test:api"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xmerlin7/CourseFlix.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Xmerlin7/CourseFlix/issues"
  },
  "homepage": "https://github.com/Xmerlin7/CourseFlix#readme",
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "devDependencies": {
    "vitest": "^4.0.14"
  },
  "overrides": {
    "typeorm": "^0.3.20"
  },
  "allowScripts": {
    "argon2": true,
    "msgpackr-extract": true,
    "unrs-resolver": true,
    "msw@2.15.0": true
  }
}
