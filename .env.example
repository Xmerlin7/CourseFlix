# CourseFlix local environment
# Copy this file to .env for local development. Keep real secrets out of Git.

# Runtime
NODE_ENV=development
PORT=3000

# Web app
# Vite only exposes variables prefixed with VITE_ to browser code.
VITE_WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

# API / CORS
API_BASE_PATH=/api/v1
WEB_ORIGIN=http://localhost:5173

# Database
# These values are local-only placeholders for Docker/PostgreSQL development.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=courseflix
POSTGRES_PASSWORD=courseflix_local_password
POSTGRES_DB=courseflix_dev
DATABASE_URL=postgresql://courseflix:courseflix_local_password@localhost:5432/courseflix_dev

# Auth / sessions
# Replace SESSION_SECRET in your local .env with a long random value.
SESSION_COOKIE_NAME=courseflix.sid
SESSION_SECRET=replace-with-a-long-random-local-secret
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Seed users for local demos/tests
SEED_STUDENT_EMAIL=student@courseflix.local
SEED_STUDENT_PASSWORD=Student123!
SEED_TEACHER_EMAIL=teacher@courseflix.local
SEED_TEACHER_PASSWORD=Teacher123!


# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Chroma
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=courseflix-dev

# Embeddings
OPENAI_API_KEY=replace-me
LLM_MODEL=gpt-5.6
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=replace-me
TUTOR_MAX_DISTANCE=1.35

# Ingestion
INGESTION_CHUNK_TOKENS=800
INGESTION_CHUNK_OVERLAP=120

# Upload
# STORAGE_ROOT must stay outside anything served statically — a stored
# PDF must never be reachable by guessing a URL.
MAX_UPLOAD_BYTES=20971520

# Storage
STORAGE_ROOT=./storage

# Attendance
# Minimum watched percentage of a video that awards attendance (CF-US-007).
ATTENDANCE_THRESHOLD_PERCENT=70

# Commerce
# Server-set deterministic course price in EGP minor units (1/100 EGP).
# 50000 = EGP 500.00. The checkout flow never accepts a client price.
COURSE_PRICE_MINOR=50000
# Seed users for local demos/tests
SEED_STUDENT_EMAIL=student@courseflix.local
SEED_STUDENT_PASSWORD=Student123!
SEED_TEACHER_EMAIL=teacher@courseflix.local
SEED_TEACHER_PASSWORD=Teacher123!
OPENAI_API_KEY=sk-proj-xxxx--xxxxx
LLM_MODEL=gpt-5.6
EMBEDDING_API_KEY=sk-proj-xxxx--xxxxx
