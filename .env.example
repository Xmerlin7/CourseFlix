# CourseFlix local environment
# Copy this file to .env for local development. Keep real secrets out of Git.

# Runtime
NODE_ENV=development
PORT=3000

# Web app
# Vite only exposes variables prefixed with VITE_ to browser code.
VITE_WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

# API / CORS
API_BASE_PATH=/api/v1
WEB_ORIGIN=http://localhost:5173

# Database
# These values are local-only placeholders for Docker/PostgreSQL development.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=courseflix
POSTGRES_PASSWORD=courseflix_local_password
POSTGRES_DB=courseflix_dev
DATABASE_URL=postgresql://courseflix:courseflix_local_password@localhost:5432/courseflix_dev

# Auth / sessions
# Replace SESSION_SECRET in your local .env with a long random value.
SESSION_COOKIE_NAME=courseflix.sid
SESSION_SECRET=replace-with-a-long-random-local-secret
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Email (OTP login / register verification / password reset)
# Sent over SMTP — defaults to Gmail's smtp.gmail.com:465, so a Gmail
# account is all that's needed, no domain to own or verify:
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Generate an App Password: myaccount.google.com/apppasswords
#      (choose "Mail" as the app) — it's a 16-character password, separate
#      from your real Gmail password and revocable any time.
#   3. SMTP_USER = that Gmail address, SMTP_PASSWORD = the App Password.
# Gmail requires the `From` header to match SMTP_USER (or a configured
# "Send As" alias on that account), so EMAIL_FROM defaults to SMTP_USER —
# only set EMAIL_FROM if you're using a different provider with a verified
# sending domain (SMTP_HOST/SMTP_PORT/SMTP_SECURE below point it anywhere
# else that speaks SMTP: a verified Resend/SendGrid/Brevo domain, etc.).
# Leave SMTP_USER/SMTP_PASSWORD as replace-me (or unset) and the API logs
# the code to the console instead of sending mail — fine for local dev.
# Each OTP endpoint additionally echoes the code as `devCode` when
# NODE_ENV != production AND delivery didn't actually happen, so a
# developer can still read it from the API response if needed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=

# Google "Continue with Google" OAuth (replace-me = button shows a friendly
# error until real credentials are set).
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
OAUTH_REDIRECT_URL=http://localhost:5173

# Seed users for local demos/tests
SEED_STUDENT_EMAIL=student@courseflix.local
SEED_STUDENT_PASSWORD=Student123!
SEED_TEACHER_EMAIL=teacher@courseflix.local
SEED_TEACHER_PASSWORD=Teacher123!
SEED_ADMIN_EMAIL=admin@courseflix.local
SEED_ADMIN_PASSWORD=Admin123!


# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Chroma
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=courseflix-dev

# Embeddings
OPENAI_API_KEY=replace-me
LLM_MODEL=gpt-5.6
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=replace-me
TUTOR_MAX_DISTANCE=1.35

# Ingestion
INGESTION_CHUNK_TOKENS=800
INGESTION_CHUNK_OVERLAP=120

# Video captions / AI video Q&A content source
# Bunny Stream library API key (per-library AccessKey, not the account key).
BUNNY_STREAM_API_KEY=replace-me
BUNNY_STREAM_API_BASE=https://video.bunnycdn.com
# YouTube and self-hosted ("local") video URLs have no captions API to
# call, so the worker downloads audio (via yt-dlp for YouTube, a direct
# fetch for local) and transcribes it with OpenAI Whisper — reuses
# OPENAI_API_KEY/EMBEDDING_API_KEY above, no separate key needed.
# yt-dlp (https://github.com/yt-dlp/yt-dlp) must be installed and on
# PATH wherever the worker runs; set YT_DLP_PATH if it isn't.
YT_DLP_PATH=yt-dlp

# Upload
# STORAGE_ROOT must stay outside anything served statically — a stored
# PDF must never be reachable by guessing a URL.
MAX_UPLOAD_BYTES=20971520

# Avatar upload (Cloudinary) — used by POST /users/me/avatar. Leave unset
# to disable custom avatar uploads (the preset picker still works without
# these); get real values from your Cloudinary dashboard, never commit them.
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Storage
STORAGE_ROOT=./storage

# Attendance
# Minimum watched percentage of a video that awards attendance (CF-US-007).
ATTENDANCE_THRESHOLD_PERCENT=70

# Commerce
# Server-set deterministic course price in EGP minor units (1/100 EGP).
# 50000 = EGP 500.00. The checkout flow never accepts a client price.
COURSE_PRICE_MINOR=50000
# Paymob Accept (real payments, CF-S4). Test credentials from the Paymob
# dashboard; callbacks point at the ngrok tunnel to the local API:
#   POST/GET https://<your-ngrok>.app/api/v1/paymob/webhook
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMOB_API_KEY=replace-me
PAYMOB_INTEGRATION_ID=0
PAYMOB_IFRAME_ID=0
PAYMOB_HMAC_SECRET=replace-me

# ngrok tunnel (optional, for Paymob callbacks to reach your local API).
# Leave empty to run without a tunnel. Get your own token (free) at:
#   https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
